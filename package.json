{
  "name": "mise-restaurant-python",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "native:sync": "npm run build && cap sync",
    "check": "npm run typecheck && npm test",
    "setup:api": "python backend/setup_accounts.py",
    "api": "python -m uvicorn mise.api:app --app-dir backend --env-file .env.local --host 127.0.0.1 --port 8080",
    "preview": "node scripts/serve-dist.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "idb-keyval": "^6.2.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.0",
    "vuetify": "^3.9.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
